# 复制成 .env 后填真实值。.env 已在 .gitignore 里，绝不提交。
# 知乎开放平台 Access Secret → https://developer.zhihu.com/profile
ZHIHU_ACCESS_SECRET=

# 以下仅收藏夹接入（P1）需要，拿不到凭证就留空
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=

# C2 non-secret runtime settings; production sets these in systemd EnvironmentFile.
# Next.js reads PORT from the process environment (or --port), not from .env.
PORT=3000
DATABASE_PATH=./data/app.sqlite

# 图片生成（AI 生图，见 team/2026-11-16/a/1116-a-生图SOP与架构-v1.md）
# 11-16 状态：密钥先空着，开账号的人未定。**只放服务器/本地 .env，绝不入库。**
# 泄露密钥是六种阻断缺陷之一（PROJECT_STATE 验收：泄露密钥）。
# 变量名待定 —— e 确认模型提供方后由 c 落定，改名时同步改 api.md 第十节。
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL=
