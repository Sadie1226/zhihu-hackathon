{
  "name": "zhihu-hackathon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint app lib/db lib/auth lib/trips lib/wishes lib/zhihu scripts/c2 scripts/c4 scripts/c5 tests next.config.ts eslint.config.mjs --max-warnings=0",
    "test": "node --test tests/*.test.mjs && node scripts/check-contracts.mjs && node scripts/check-mailbox.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.2",
    "typescript": "5.9.3"
  }
}
